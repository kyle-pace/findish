# Security headers for every page and file Cloudflare serves from this folder (added
# 2026-11-17). They don't reach /mcp or /api/*, which the Worker answers itself. The build
# adds the long cache rule for /_astro/* below these.
#
# The Content-Security-Policy is the safe half only: nobody may frame the site, change
# its base address, post its forms elsewhere or embed plugins. It does not limit scripts,
# images or connections yet: the pages use inline scripts, photos come from every recipe
# site, and Cloudflare adds its own script, so that half needs Kyle's decisions first
# (see AGENTS.md, "Security headers").
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  X-Frame-Options: DENY
  Content-Security-Policy: base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'

/manifest.webmanifest
  Content-Type: application/manifest+json

# The index as the page loads it (scripts/build-index.mjs). Each file is named after what's
# in it, so a browser can keep it for a year and never ask again; a new crawl makes new names.
/i/*
  Cache-Control: public, max-age=31536000, immutable

# Explore's full-screen globe, page browser and their data (public/explore/app/, staged by
# scripts/stage-explore.mjs). Kept out of search engines: they are an app and its data
# files, and /explore/ is the page meant to be found. The globe is shown inside a frame on
# /explore/, so these files alone may be framed, and only by finDish's own pages.
/explore/app/*
  X-Robots-Tag: noindex
  ! X-Frame-Options
  ! Content-Security-Policy
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'
