---
// One browse page: a cuisine (/cuisine/korean/), a course (/course/soup/) or an ingredient
// (/with/tofu/). A short list of recipes by name, time and creator, each linking out to the
// original, and the way into the full search. Built at build time (src/lib/browse.ts); see
// design/PLAN.md, "Browse pages". The structured data is a plain list of links (ItemList)
// and a breadcrumb: never Recipe markup, because the recipes aren't ours.
import LabLayout from 'kp-design/layouts/LabLayout.astro';
import { jsonForScript } from '../lib/json-script.mjs';
import { SITE } from '../lib/site';
import SiteHead from './SiteHead.astro';
import { andList, fmtTime, n, pagePath } from '../lib/creators';
import { cuisinesFor, signatureIngredients, QUICK_MINUTES, type Browse } from '../lib/browse';
import { aboutHtml } from '../lib/explore';
import '../styles/explore.css';
import '../styles/theme.css';
import '../styles/creators.css';
import '../styles/browse.css';

const { b } = Astro.props as { b: Browse };
const count = b.count.toLocaleString('en-US');
const cooks = b.creators.length === 1 ? b.creators[0].creator.name : `${b.creators.length} independent cooks`;
const what = b.kind === 'with' ? `recipes with ${b.name}` : b.heading.replace(/^./, (c) => (b.kind === 'cuisine' ? c : c.toLowerCase()));
const lede =
  b.kind === 'with'
    ? `${count} recipes that use ${b.name}, from ${cooks}.`
    : `${count} ${what} from ${cooks}.`;
// An ingredient page's title says what you can make with it and from how many cooks:
// "Celery recipes: mains, soups and sides from 35 cooks | finDish" (Kyle's pick, 2026-11-26,
// over a count or a "ready in 30 minutes" hook). The courses and the number come from the
// index, so they follow each weekly crawl. A page with fewer than two courses, or a title too
// long for a search result, falls back to one course fewer, then to the cooks alone.
const COURSE_WORDS: Record<string, string> = {
  main: 'mains', side: 'sides', soup: 'soups', starter: 'snacks', breakfast: 'breakfasts',
  dessert: 'desserts', bread: 'breads', sauce: 'sauces', drink: 'drinks',
};
// People search "tomato recipes", not "tomatoes recipes": the last word of each name (each
// side of an "or") goes singular, except "greens", which reads wrong as "green".
const one = (w: string) =>
  /greens$|(ss|us|is)$/.test(w) ? w : w.endsWith('chilies') ? w.slice(0, -2) : w.endsWith('ies') ? w.slice(0, -3) + 'y' : w.endsWith('oes') ? w.slice(0, -2) : w.endsWith('aves') ? w.slice(0, -3) + 'f' : w.endsWith('s') ? w.slice(0, -1) : w;
const single = b.name.split(' or ').map((part) => part.replace(/\S+$/, one)).join(' or ');
const Name = single.replace(/^./, (c) => c.toUpperCase());
function withTitle(): string {
  const cookCount = `${b.creators.length} ${b.creators.length === 1 ? 'cook' : 'cooks'}`;
  const words = b.courses.map((c) => COURSE_WORDS[c.id]).filter(Boolean);
  for (const k of [3, 2]) {
    if (words.length < k) continue;
    const t = `${Name} recipes: ${andList(words.slice(0, k))} from ${cookCount} | finDish`;
    if (t.length <= 65) return t;
  }
  return `${Name} recipes from ${b.creators.length === 1 ? cooks : cookCount.replace('cooks', 'independent cooks')} | finDish`;
}
const title = b.kind === 'with' ? withTitle() : `${b.heading} from independent cooks: finDish`;
// "A, B, C and more", not "A, B and C and more".
const names = b.creators.length > 3 ? `${b.creators.slice(0, 3).map((x) => x.creator.name).join(', ')} and more` : andList(b.creators.map((x) => x.creator.name));
// An ingredient page's description also says how many are quick, for searches like "quick
// celery dinner" (the top one in Search Console in November 2026).
const quickCount = b.quickCount.toLocaleString('en-US');
const description =
  b.kind === 'with' && b.quick.length
    ? `${count} ${what}, ${quickCount} ready in ${QUICK_MINUTES} minutes or less, from ${names}. Every one opens on the cook’s own site.`
    : `${count} ${what} from ${names}. Every one opens on the cook’s own site.`;
const quickSearch = `${b.search}&time=${QUICK_MINUTES}`;
// A cuisine page says what it's mostly made of and which ingredients it leans on, with links to
// those ingredients' pages and to the cuisine on World cuisine. An ingredient page links to the
// cuisine pages that cook with it most.
const lean = b.kind === 'cuisine' ? signatureIngredients(b) : [];
const courseWords = b.courses.map((c) => COURSE_WORDS[c.id]).filter(Boolean).slice(0, 3);
// What Explore knows about this cuisine or ingredient (its photo, dishes and where it's
// cooked), shown as this page's About section since 2026-11-26. It used to be a link out to
// World cuisine; the explorer's own page for it now forwards here (src/lib/explore.ts).
const about = aboutHtml(b);
const related = b.kind === 'with' ? cuisinesFor(b) : lean;
const cap = (s: string) => s.replace(/^./, (c) => c.toUpperCase());
const searchAll = `Search all ${count} ${what}`;
const openedFrom = b.kind === 'with' ? 'ingredient' : b.kind;
const url = (path: string) => new URL(path, 'https://findish.now').href;
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'finDish', item: url('/') },
        { '@type': 'ListItem', position: 2, name: 'Browse', item: url('/browse/') },
        { '@type': 'ListItem', position: 3, name: b.heading, item: url(b.path) },
      ],
    },
    {
      '@type': 'ItemList',
      name: b.heading,
      numberOfItems: b.rows.length,
      itemListElement: b.rows.map((r, k) => ({ '@type': 'ListItem', position: k + 1, name: r.name, url: r.url })),
    },
  ],
};
---

<LabLayout
  favicon="/favicon-v4.svg"
  site={SITE}
  bar={false}
  lab={{ name: 'the search', href: '/' }}
  about="/about/"
  title={title}
  description={description}
  image="/og.png"
  imageAlt="finDish: a search box holding ginger and tofu. Recipes from The Woks of Life, Hot Thai Kitchen, Smitten Kitchen and more."
  themeColor={{ light: '#fbf5ec', dark: '#1d1714' }}
>
  <link slot="head" rel="manifest" href="/manifest.webmanifest" />
  <script slot="head" type="application/ld+json" set:html={jsonForScript(ld)} />
  <SiteHead wide />

  <article class="creator browse" data-page="browse" data-browse-kind={openedFrom} data-browse-page={b.slug}>
    <header class="who" data-section="top">
      <h1>{b.heading}</h1>
      <p class="lede">{lede} Each one opens on the cook’s own site, where the full recipe is.</p>
      {
        b.kind === 'cuisine' && (courseWords.length > 1 || lean.length > 2) && (
          <p class="intro">
            {courseWords.length > 1 && <>Mostly {andList(courseWords)}. </>}
            {lean.length > 2 && (
              <>
                They lean on{' '}
                {lean.slice(0, 3).map((x, k) => (
                  <>
                    {k > 0 && (k === 2 ? ' and ' : ', ')}
                    <a href={x.path} data-browse-kind="ingredient" data-browse-page={x.slug}>{x.name}</a>
                  </>
                ))}
                {' '}more than most.
              </>
            )}
          </p>
        )
      }
      {
        about && (
          <p class="world">
            <a href="#about" data-explore="jump">About {about.name.replace(/^[A-Z]/, (c) => (b.kind === 'with' ? c.toLowerCase() : c))}: {b.kind === 'cuisine' ? 'its dishes and where it’s from' : 'where in the world it’s cooked with'}</a>
          </p>
        )
      }
      <p class="go-row">
        <a class="go-link" href={b.search} data-full-search>{searchAll}</a>
      </p>
    </header>

    {
      b.quick.length > 0 && (
        <section class="picks quick" aria-labelledby="quick" data-section="quick">
          <h2 id="quick">Ready in {QUICK_MINUTES} minutes or less</h2>
          <ol class="rows">
            {b.quick.map((r, k) => (
              <li>
                <article class="row">
                  <div class="text">
                    <h3>
                      <a href={r.url} data-src-id={r.source} data-key={r.key} data-pos={k + 1}>
                        {r.name}
                      </a>
                    </h3>
                    <p class="meta">{[r.minutes ? fmtTime(r.minutes) : '', r.cuisine, `from ${r.creator}`].filter(Boolean).join(', ')}</p>
                  </div>
                  <div class="photo">
                    {r.img ? (
                      <img src={r.img} alt="" width="320" height="240" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                    ) : (
                      <span class="no-photo" aria-hidden="true"></span>
                    )}
                  </div>
                </article>
              </li>
            ))}
          </ol>
          {b.quickCount > b.quick.length && (
            <p class="all">
              <a href={quickSearch} data-full-search>
                See all {quickCount} quick recipes with {b.name}
              </a>
            </p>
          )}
        </section>
      )
    }

    <section class="picks" aria-labelledby="picks" data-section="picks">
      <h2 id="picks">{b.count > b.rows.length + b.quick.length ? (b.quick.length ? 'More to start with' : 'A few to start with') : b.quick.length ? 'The rest of them' : 'All of them'}</h2>
      <ol class="rows">
        {
          b.rows.map((r, k) => (
            <li>
              <article class="row">
                <div class="text">
                  <h3>
                    <a href={r.url} data-src-id={r.source} data-key={r.key} data-pos={k + 1}>
                      {r.name}
                    </a>
                  </h3>
                  <p class="meta">{[r.minutes ? fmtTime(r.minutes) : '', b.kind === 'cuisine' ? '' : r.cuisine, `from ${r.creator}`].filter(Boolean).join(', ')}</p>
                </div>
                <div class="photo">
                  {r.img ? (
                    <img src={r.img} alt="" width="320" height="240" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                  ) : (
                    <span class="no-photo" aria-hidden="true"></span>
                  )}
                </div>
              </article>
            </li>
          ))
        }
      </ol>
      {
        b.count > b.rows.length + b.quick.length && (
          <p class="all">
            <a href={b.search} data-full-search>
              {searchAll}
            </a>
          </p>
        )
      }
    </section>

    {
      b.narrower.length > 1 && (
        <section aria-labelledby="narrow" data-section="narrower">
          <h2 id="narrow">{b.kind === 'cuisine' ? 'By course' : 'By cuisine'}</h2>
          <ul class="list">
            {b.narrower.map((x) => (
              <li>
                <a href={x.href} data-full-search>
                  {x.label}
                </a>
                <span class="has">{n(x.count, 'recipe')}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      related.length > 1 && (
        <section aria-labelledby="related" data-section="related">
          <h2 id="related">{b.kind === 'with' ? `Cuisines that cook with ${b.name}` : `Cook ${b.name} with`}</h2>
          <ul class="list">
            {related.map((x) => (
              <li>
                <a href={x.path} data-browse-kind={x.kind === 'with' ? 'ingredient' : x.kind} data-browse-page={x.slug}>
                  {x.kind === 'with' ? cap(x.name) : x.heading}
                </a>
                <span class="has">{n(x.count, 'recipe')}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section aria-labelledby="cooks" data-section="cooks">
      <h2 id="cooks">Who they’re from</h2>
      <ul class="list">
        {
          b.creators.map(({ creator, count }) => (
            <li>
              <a href={pagePath(creator.id)} data-creator-page={creator.id}>
                {creator.name}
              </a>
              <span class="has">{n(count, 'recipe')}</span>
            </li>
          ))
        }
      </ul>
    </section>

    {
      about && (
        <section class="cx about" id="about" data-section="about" aria-labelledby="about-h">
          <h2 id="about-h">About {about.name.replace(/^[A-Z]/, (c) => (b.kind === 'with' ? c.toLowerCase() : c))}</h2>
          <Fragment set:html={about.html} />
        </section>
      )
    }

    <p class="more"><a href="/browse/">Browse other cuisines, courses and ingredients</a></p>
  </article>

  <script>
    import '../scripts/browse';
  </script>
</LabLayout>
