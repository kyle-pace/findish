---
// The week's shelves: recipes picked by rules from the index (src/lib/collections.mjs), new
// every Monday crawl. This was the Discover page (/discover/, 2026-11-22); since 2026-11-26
// it is the second half of Explore (/explore/#shelves), and /discover/ forwards there
// (Kyle's call: Explore and Discover are one section). Like the browse pages it is a list
// of links out to the cooks' own sites; never the method, never Recipe markup.
// Its events are src/scripts/discover.ts; they look for data-page="discover".
import { fmtTime, n, pagePath } from '../lib/creators';
import { DISCOVER } from '../lib/discover';
import '../styles/creators.css';
import '../styles/browse.css';
import '../styles/discover.css';

const { shelves } = DISCOVER;
---

<section class="creators-page browse discover" id="shelves" data-page="discover" aria-labelledby="shelves-h">
  <h2 id="shelves-h" class="shelves-h">Recipes for this week</h2>
  <p class="lede">Grouped for the week from the recipes here, and new every Monday. Every one opens on the cook’s own site.</p>

    <nav class="contents" aria-labelledby="contents">
      <h3 id="contents">On the shelves</h3>
      <ul class="list">
        {
          shelves.map((s, k) => (
            <li>
              <a href={`#${s.id}`} data-jump={s.id} data-pos={k + 1}>
                {s.title}
              </a>
              <span class="has">{n(s.count, 'recipe')}</span>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      shelves.map((s) => (
        <section class="shelf-of" id={s.id} data-collection={s.id} aria-labelledby={`${s.id}-h`}>
          <header>
            <h3 id={`${s.id}-h`}>{s.title}</h3>
            <span class="has">{n(s.count, 'recipe')}</span>
          </header>
          <p class="blurb">{s.blurb}</p>
          <ol class="rows">
            {s.rows.map((r, k) => (
              <li>
                <article class="row">
                  <div class="text">
                    <h4>
                      <a href={r.url} data-src-id={r.source} data-key={r.key} data-pos={k + 1}>
                        {r.name}
                      </a>
                    </h4>
                    <p class="meta">{[r.minutes ? fmtTime(r.minutes) : '', s.creator ? r.cuisine : `from ${r.creator}`].filter(Boolean).join(', ')}</p>
                  </div>
                  <div class="photo">
                    {r.img ? (
                      <img src={r.img} alt="" width="320" height="240" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                    ) : (
                      <span class="no-photo" aria-hidden="true" />
                    )}
                  </div>
                </article>
              </li>
            ))}
          </ol>
          {s.creator ? (
            <p class="all">
              <a href={pagePath(s.creator)} data-creator-page={s.creator}>
                More from {s.rows[0]?.creator}, and ways to back them
              </a>
            </p>
          ) : (
            s.count > s.rows.length && (
              <p class="all">
                <a href={`/?collection=${encodeURIComponent(s.id)}`} data-full-search>
                  See all {n(s.count, 'recipe')}
                </a>
              </p>
            )
          )}
        </section>
      ))
    }

</section>

<script>
  import '../scripts/discover';
</script>
