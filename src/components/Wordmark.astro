---
// The Findish wordmark (Kyle's pick, 2026-11-16): "fin", a plate-shaped d in tomato red, "ish".
// A line runs over "find" and another under "dish", both across the d, so the two words read
// and the d is where they meet. The d (a plate seen from above, with its stem) has strokes as
// heavy as the bold letters and no extra room on its right, so the gaps either side are even.
// Every part gets the same line above and below (clear where none shows), so the letters stay
// on one baseline.
// Text and CSS plus one small inline SVG: it scales with the font size it's given and
// follows light and dark mode. Screen readers hear one word, "Findish".
const plate = '<svg viewBox="0 0 52 76" class="wordmark-plate" focusable="false"><circle cx="25" cy="50" r="18.5" fill="none" stroke="currentColor" stroke-width="11"/><circle cx="25" cy="50" r="7" fill="currentColor" opacity="0.35"/><rect x="38" y="2" width="11" height="72" rx="5.5" fill="currentColor"/></svg>';
---

<span class="wordmark"><span class="wordmark-text">Findish</span><span class="wordmark-art" aria-hidden="true"><span class="wm-fin">fin</span><span class="wm-d" set:html={plate}></span><span class="wm-ish">ish</span></span></span>

<style>
  .wordmark {
    display: inline-block;
    font-weight: 700;
    letter-spacing: -0.02em;
    white-space: nowrap;
    line-height: 1;
  }

  /* The name for screen readers and copy-paste; the drawn version is hidden from them. */
  .wordmark-text {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .wordmark-art {
    --bar: 0.08em;
    display: inline-flex;
    align-items: stretch;
  }

  .wm-fin,
  .wm-d,
  .wm-ish {
    border-block: var(--bar) solid transparent;
    padding-block: 0.04em 0.06em;
  }

  /* Over "find"… */
  .wm-fin,
  .wm-d {
    border-top-color: var(--accent-ink);
  }

  /* …and under "dish". */
  .wm-d,
  .wm-ish {
    border-bottom-color: var(--accent-ink);
  }

  /* The plate d, sitting on the baseline */
  .wm-d {
    display: flex;
    align-items: flex-end;
    padding-inline: 0.02em;
  }

  .wm-d :global(.wordmark-plate) {
    display: block;
    width: 0.507em;
    height: 0.74em;
    margin-bottom: 0.15em;
    color: var(--accent-ink);
  }

  @media (forced-colors: active) {
    .wm-fin,
    .wm-d {
      border-top-color: CanvasText;
    }

    .wm-d,
    .wm-ish {
      border-bottom-color: CanvasText;
    }

    .wm-d :global(.wordmark-plate) {
      color: CanvasText;
    }
  }
</style>
