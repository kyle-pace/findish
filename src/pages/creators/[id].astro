---
// One creator's page: who they are, a search box for just their recipes, what's new from
// them when the latest crawl found any, how to back them (join, buy, follow, most helpful
// first) and a few of their recipes. Built at build time for every creator in the index
// (src/lib/creators.ts). Added 2026-11-16; see design/PLAN.md, "Creator pages".
import LabLayout from 'kp-design/layouts/LabLayout.astro';
import { jsonForScript } from '../../lib/json-script.mjs';
import { SITE } from '../../lib/site';
import SiteHead from '../../components/SiteHead.astro';
import { CREATORS, andList, fmtTime, n, pagePath, slugOf, type Creator } from '../../lib/creators';
import { cuisinePath } from '../../lib/browse';
import '../../styles/theme.css';
import '../../styles/creators.css';

export function getStaticPaths() {
  return CREATORS.map((c) => ({ params: { id: slugOf(c.id) }, props: { c } }));
}

const { c } = Astro.props as { c: Creator };
const has = [c.recipes ? n(c.recipes, 'recipe') : '', c.videos ? n(c.videos, 'video') : ''].filter(Boolean);
const lede = `${has.length ? andList(has) : 'Nothing yet'}${c.cuisine ? `, mostly ${c.cuisine}` : ''}.`;
const search = `/?site=${encodeURIComponent(c.id)}`;
const books = c.buy.filter((l) => l.book);
const shops = c.buy.filter((l) => !l.book);
const backs = c.join.length + c.buy.length + c.follow.length > 0;
const description = `${c.name} on Findish: ${lede.replace(/\.$/, '')}. Ways to back them${
  c.join.length || books.length ? `, like ${andList([...c.join.map((l) => l.label), ...(books.length ? [books.length === 1 ? 'their cookbook' : 'their cookbooks'] : [])])}` : ''
}, and a few of their recipes.`;
// The cuisines they cook that have a browse page, with how many of their recipes each is.
const cuisines = c.cuisines.filter((x) => cuisinePath(x.name)).slice(0, 8);
const url = (path: string) => new URL(path, 'https://findish.now').href;
// Who the page is about, for search engines: a profile of the creator (their own site and
// the places they publish), and where the page sits. Nothing about their recipes' contents.
const sameAs = [...new Set([c.channel, ...c.follow.map((l) => l.url)].filter((u): u is string => !!u && u !== c.url))];
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfilePage',
      url: url(pagePath(c.id)),
      name: `${c.name} on Findish`,
      mainEntity: { '@type': 'Organization', name: c.name, url: c.url, ...(sameAs.length ? { sameAs } : {}) },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Findish', item: url('/') },
        { '@type': 'ListItem', position: 2, name: 'Creators', item: url('/creators/') },
        { '@type': 'ListItem', position: 3, name: c.name, item: url(pagePath(c.id)) },
      ],
    },
  ],
};
---

<LabLayout
  favicon="/favicon-v3.svg"
  site={SITE}
  bar={false}
  lab={{ name: 'the search', href: '/' }}
  about="/about/"
  title={`${c.name} on Findish: recipes and ways to back them`}
  description={description}
  image="/og-creators.png"
  imageAlt="Findish creators: the people behind the recipes, and how to back them."
  themeColor={{ light: '#fbf5ec', dark: '#1d1714' }}
>
  <link slot="head" rel="manifest" href="/manifest.webmanifest" />
  <script slot="head" type="application/ld+json" set:html={jsonForScript(ld)} />
  <SiteHead wide />

  <article class="creator" data-page="creator" data-creator={c.id}>
    <header class="who">
      <h1>{c.name}</h1>
      <p class="lede">{lede}</p>
      {
        c.paused === 'blocked' && (
          <p class="paused">Their recipes are on hold here while their site keeps the weekly program out. Their own site has every one of them.</p>
        )
      }
      {c.paused === 'new' && <p class="paused">Their recipes arrive with the next weekly update.</p>}
      {
        (c.recipes > 0 || c.videos > 0) && (
          // A search of just this creator: it opens the search page with them as a tag and the
          // words in the box (/?site=<id>&q=…). Left empty, it shows everything from them.
          <form class="find-theirs" action="/" method="get" role="search" aria-label={c.name} data-search-creator={c.id}>
            <input type="hidden" name="site" value={c.id} />
            <label for="their-q">Search their {c.recipes ? n(c.recipes, 'recipe') : n(c.videos, 'video')}</label>
            <div class="find-row">
              <input id="their-q" name="q" type="search" autocomplete="off" autocapitalize="none" spellcheck="false" enterkeyhint="search" placeholder="A dish or an ingredient" />
              <button type="submit">Search</button>
            </div>
          </form>
        )
      }
      <p class="go-row">
        <a href={c.url} data-support={c.id} data-kind="site">{c.host}</a>
      </p>
    </header>

    {
      c.fresh.length > 0 && (
        <section class="picks fresh" aria-labelledby="fresh">
          <h2 id="fresh">New from them this week</h2>
          <ol class="rows">
            {c.fresh.slice(0, 6).map((p, k) => (
              <li>
                <article class="row">
                  <div class="text">
                    <h3>
                      <a href={p.url} data-src-id={c.id} data-key={p.key} data-pos={k + 1} data-new>
                        {p.name}
                      </a>
                    </h3>
                    <p class="meta">{[p.minutes ? fmtTime(p.minutes) : '', p.cuisine].filter(Boolean).join(', ') || c.host}</p>
                  </div>
                  <div class="photo">
                    {p.img ? (
                      <img src={p.img} alt="" width="320" height="240" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                    ) : (
                      <span class="no-photo" aria-hidden="true"></span>
                    )}
                  </div>
                </article>
              </li>
            ))}
          </ol>
          {c.fresh.length > 6 && (
            <p class="all">
              <a href={`/?new=1&site=${encodeURIComponent(c.id)}`} data-search-creator={c.id}>
                See all {c.fresh.length} new from {c.name}
              </a>
            </p>
          )}
        </section>
      )
    }

    <section class="back" aria-labelledby="back">
      <h2 id="back">How to back them</h2>
      {
        !backs && (
          <p class="why">
            Nothing listed yet. Cooking from <a href={c.url} data-support={c.id} data-kind="site">their own site</a> is still the best thanks: it’s
            how they earn from their recipes.
          </p>
        )
      }
      {
        c.join.length > 0 && (
          <div class="way">
            <h3>Join</h3>
            <p class="why">Pays them directly, which helps most.</p>
            <ul class="links big">
              {c.join.map((l) => (
                <li>
                  <a href={l.url} data-support={c.id} data-kind="join">
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
      {
        c.buy.length > 0 && (
          <div class="way">
            <h3>Buy</h3>
            {books.length > 0 && (
              <>
                <p class="why">Book links go to Bookshop.org, which pays the author and an independent bookstore.</p>
                <ul class="shelf">
                  {books.map((b) => (
                    <li>
                      <a href={b.url} data-support={c.id} data-kind="book">
                        <span class="slot">
                          {b.cover ? (
                            <img src={b.cover} alt="" width={b.coverWidth || 200} height={b.coverHeight || 300} loading="lazy" decoding="async" />
                          ) : (
                            <span class="cloth" aria-hidden="true">
                              <span>{b.label}</span>
                            </span>
                          )}
                        </span>
                        <cite>{b.label}</cite>
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            )}
            {shops.length > 0 && (
              <ul class="links">
                {shops.map((l) => (
                  <li>
                    <a href={l.url} data-support={c.id} data-kind="shop">
                      {l.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        )
      }
      {
        c.follow.length > 0 && (
          <div class="way">
            <h3>Follow</h3>
            <p class="why">Free, and it still counts.</p>
            <ul class="links">
              {c.follow.map((l) => (
                <li>
                  <a href={l.url} data-support={c.id} data-kind="follow">
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </section>

    {
      c.picks.length > 0 && (
        <section class="picks" aria-labelledby="picks">
          <h2 id="picks">A few of their recipes</h2>
          <ol class="rows">
            {c.picks.map((p, k) => (
              <li>
                <article class="row">
                  <div class="text">
                    <h3>
                      <a href={p.url} data-src-id={c.id} data-key={p.key} data-pos={k + 1}>
                        {p.name}
                      </a>
                    </h3>
                    <p class="meta">{[p.minutes ? fmtTime(p.minutes) : '', p.cuisine].filter(Boolean).join(', ') || c.host}</p>
                  </div>
                  <div class="photo">
                    {p.img ? (
                      <img src={p.img} alt="" width="320" height="240" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                    ) : (
                      <span class="no-photo" aria-hidden="true"></span>
                    )}
                  </div>
                </article>
              </li>
            ))}
          </ol>
          {c.recipes > c.picks.length && (
            <p class="all">
              <a href={search} data-search-creator={c.id}>
                Search all {n(c.recipes, 'recipe')} from {c.name}
              </a>
            </p>
          )}
        </section>
      )
    }

    {
      c.videoPicks.length > 0 && (
        <section class="picks" aria-labelledby="videos">
          <h2 id="videos">Their newest videos</h2>
          <ol class="rows">
            {c.videoPicks.map((v, k) => (
              <li>
                <article class="row">
                  <div class="text">
                    <h3>
                      <a href={`https://www.youtube.com/watch?v=${v.id}`} data-src-id="youtube" data-pos={k + 1}>
                        {v.name}
                      </a>
                    </h3>
                    <p class="meta">Video on YouTube</p>
                  </div>
                  <div class="photo video">
                    <img src={`https://i.ytimg.com/vi/${v.id}/mqdefault.jpg`} alt="" width="320" height="180" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                  </div>
                </article>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      cuisines.length > 0 && (
        <section class="cooks" aria-labelledby="cuisines">
          <h2 id="cuisines">What they cook</h2>
          <ul class="list">
            {cuisines.map((x) => (
              <li>
                <a href={cuisinePath(x.name)} data-browse-kind="cuisine" data-browse-page={cuisinePath(x.name)!.split('/')[2]}>
                  {x.name}
                </a>
                <span class="has">{n(x.count, 'recipe')} from {c.name}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <p class="more"><a href="/creators/">All creators</a></p>
  </article>

  <script>
    import '../../scripts/creators';
  </script>
</LabLayout>
