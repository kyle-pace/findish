---
// Explore (/explore/, added 2026-11-26): where to go when you don't know what to search for (model A, design/PLAN.md, "Search and Explore"). In order of how directly
// each part gets someone to a recipe (Kyle, 2026-11-26: the globe "is a cool feature, but
// not the most effective way to find something"): the week's recipe shelves
// (src/components/DiscoverShelves.astro, once the Discover page), then cuisines, ingredients
// and courses with their counts. The globe has its own page, /explore/globe/ (globe.astro),
// linked from this page's first lines; an old #cuisine link here is sent on to it.
// Listed while EXPLORE_LISTED in src/lib/site.ts is on.
import LabLayout from 'kp-design/layouts/LabLayout.astro';
import { SITE, EXPLORE_LISTED } from '../../lib/site';
import SiteHead from '../../components/SiteHead.astro';
import DiscoverShelves from '../../components/DiscoverShelves.astro';
import { n, CREATORS } from '../../lib/creators';
import { CUISINES, COURSES, INGREDIENTS, type Browse } from '../../lib/browse';
import cuisineData from '../../../vendor/explore/data/cuisines.json';
import foodData from '../../../vendor/explore/data/food.json';
import '../../styles/theme.css';
import '../../styles/creators.css';
import '../../styles/browse.css';
import '../../styles/explore.css';

const cuisines: { kind: string; iso3: string }[] = (cuisineData as any).cuisines ?? [];
const dishCount: number = ((foodData as any).dishes ?? []).length;
const countries = new Set(cuisines.filter((c) => c.kind === 'national').map((c) => c.iso3)).size;
const round = (n: number) => Math.floor(n / 10) * 10;

// The most cooked of each, not all of them: /browse/ has the full lists.
const TOP = 12;
const byCount = (list: Browse[]) => [...list].sort((a, b) => b.count - a.count).slice(0, TOP);
const cap = (s: string) => s.replace(/^./, (c) => c.toUpperCase());
const groups: { id: string; name: string; kind: string; list: Browse[]; all?: { href: string; label: string } }[] = [
  { id: 'by-cuisine', name: 'By cuisine', kind: 'cuisine', list: byCount(CUISINES), all: { href: '/browse/#cuisines', label: `All ${CUISINES.length} cuisines` } },
  { id: 'by-ingredient', name: 'By ingredient', kind: 'ingredient', list: byCount(INGREDIENTS), all: { href: '/browse/#ingredients', label: `All ${INGREDIENTS.length} ingredients` } },
  { id: 'by-course', name: 'By course', kind: 'course', list: COURSES },
];
---

<LabLayout
  favicon="/favicon-v4.svg"
  site={SITE}
  bar={false}
  lab={{ name: 'the search', href: '/' }}
  about="/about/"
  title="Explore this week’s recipes, cuisines and ingredients: finDish"
  description={`Recipes picked for this week, ${CUISINES.length} cuisines and ${INGREDIENTS.length} ingredients, and a globe of more than ${round(cuisines.length)} of the world’s cuisines. Every recipe opens on its creator’s own site.`}
  image="/explore/share.png"
  imageAlt="A dark globe with countries colored by continent and thin routes arcing between them."
  themeColor={{ light: '#fbf5ec', dark: '#1d1714' }}
  noindex={!EXPLORE_LISTED}
>
  <link slot="head" rel="manifest" href="/manifest.webmanifest" />
  <SiteHead wide />

  <article class="explore-page" data-page="explore">
    <header>
      <h1>Explore</h1>
      <p class="lede">Recipes picked for this week, every cuisine, ingredient and course, and the globe.</p>
      <nav class="jump" aria-label="On this page">
        <a href="#shelves">This week’s recipes</a>
        <a href="#browse">Cuisines and ingredients</a>
        <a class="globe-open" href="/explore/globe/" data-globe>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9.5" /><ellipse cx="12" cy="12" rx="4" ry="9.5" /><path d="M2.5 12h19" /></svg>
          The globe
        </a>
      </nav>
    </header>

    <DiscoverShelves />

    <section class="creators-page browse explore-browse" id="browse" aria-labelledby="browse-h">
      <h2 id="browse-h" class="shelves-h">Cuisines, ingredients and courses</h2>
      {
        groups.map((g) => (
          <section class="group" aria-labelledby={g.id}>
            <h3 id={g.id}>{g.name}</h3>
            <ul class="list">
              {g.list.map((b) => (
                <li>
                  <a href={b.path} data-browse-kind={g.kind} data-browse-page={b.slug}>
                    {b.kind === 'with' ? cap(b.name) : b.name}
                  </a>
                  <span class="has">{n(b.count, 'recipe')}</span>
                </li>
              ))}
            </ul>
            {g.all && (
              <p class="all">
                <a href={g.all.href}>{g.all.label}</a>
              </p>
            )}
          </section>
        ))
      }
      <p class="all">
        Or start from a cook: <a href="/creators/">all {CREATORS.length} creators</a>.
      </p>
    </section>

  </article>
</LabLayout>

<script>
  import { track } from 'kp-design/analytics';
  // A link made for the globe when it was framed here (findish.now/explore/#thai-cuisine)
  // goes on to the globe's own page. This page's own sections stay.
  const hash = location.hash.slice(1);
  if (hash && !document.getElementById(hash)) location.replace('/explore/globe/' + location.hash);
  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a');
    if (!a) return;
    if ('globe' in a.dataset) track('Opened Explore Page', { explore_kind: 'globe', opened_from: 'explore' });
    else if (a.dataset.browseKind && a.dataset.browsePage && a.closest('#browse'))
      track('Opened Browse Page', { browse_kind: a.dataset.browseKind, browse_page: a.dataset.browsePage, opened_from: 'explore' });
  });
</script>
