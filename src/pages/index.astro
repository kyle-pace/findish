---
// Findish: one search across the recipe sites Kyle trusts, from our own index
// (public/index.json, built from data/ by scripts/build-index.mjs).
// src/scripts/search.ts loads the index and searches it in the browser.
//
// One search box, centered like a search engine's home page; after a search it moves up
// and results fill the page. Ingredients and creators picked from the suggestions become
// tags in the box. design/PLAN.md has the reasoning. About is its own page (about.astro).
// It's a standalone lab: LabLayout gives it only a back link, a footer line, display
// settings and analytics; its look is src/styles/theme.css.
import LabLayout from 'kp-design/layouts/LabLayout.astro';
import { SITE } from '../lib/site';
import Wordmark from '../components/Wordmark.astro';
import '../styles/theme.css';
// The totals under the name are worked out at build time, so the line is there from the
// first paint and nothing moves when the index arrives (search.ts writes the same words).
import indexJson from '../../public/index.json';
import { prepare } from '../lib/search-core.mjs';

const index: any = indexJson;
const count = (n: number, one: string) => `${n.toLocaleString('en-US')} ${n === 1 ? one : one + 's'}`;
const creators = prepare(index).creators;
const fromLine = `${count(index.recipes.length, 'recipe')} and ${count(index.videos.rows.length, 'video')} from ${creators.length} creators. Every one opens on its creator’s own site.`;
// Creator names by id, for the tags a link to a search shows before the index has loaded.
const creatorNames = JSON.stringify(Object.fromEntries(creators.map((c: { id: string; name: string }) => [c.id, c.name])));
const FILTERS = [
  ['show', 'Show'],
  ['course', 'Course'],
  ['cuisine', 'Cuisine'],
  ['site', 'Creators'],
  ['time', 'Ready in'],
];
---

<LabLayout
  favicon="/favicon-v3.svg"
  site={SITE}
  bar={false}
  lab={{ name: 'the search', href: '/' }}
  about="/about/"
  welcome={{ name: "Findish", text: "One search box across The Woks of Life, Hot Thai Kitchen, Smitten Kitchen and the YouTube channels of the cooks I learn from, from a small index of my own. Search by dish, by what you have or by creator; every result opens on the creator’s site." }}
  title="Findish: one search for recipes from independent cooks"
  description="Search The Woks of Life, Hot Thai Kitchen, Smitten Kitchen and more at once, by dish, by what you have or by creator. Every recipe opens on its own site."
  image="/og.png"
  imageAlt="Findish: a search box holding ginger and tofu. Recipes from The Woks of Life, Hot Thai Kitchen, Smitten Kitchen and more."
  themeColor={{ light: '#fbf5ec', dark: '#1d1714' }}
>
  <!-- Verifies findish.now in Google Search Console (2026-11-16). Keep it. -->
  <meta slot="head" name="google-site-verification" content="_hVdo4bdUjJmjTStuwg87sYAeLc9GErXZCn0_c9hj9I" />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Findish',
    url: 'https://findish.now/',
    description: 'One search box across recipe sites from independent cooks. Every result opens on the creator’s own site.',
    potentialAction: { '@type': 'SearchAction', target: 'https://findish.now/?q={search_term_string}', 'query-input': 'required name=search_term_string' },
    publisher: { '@type': 'Person', '@id': 'https://kylepace.net/#kyle', name: 'Kyle Pace', url: 'https://kylepace.net/' },
  })} />
  <link slot="head" rel="preload" href="/index.json" as="fetch" crossorigin="anonymous" />
  <link slot="head" rel="manifest" href="/manifest.webmanifest" />
  <script slot="head" is:inline>
    // The About section used to live at #about; it's its own page now.
    if (location.hash === '#about') location.replace('/about/');
  </script>

  <div class="page" id="page" data-mode="home">
    <script is:inline>
      // A link to a search is laid out as results from the first paint (the box at the top,
      // the filters under it), so nothing jumps when the recipes arrive. search.ts takes over.
      if (/[?&](q|with|site|time|cuisine|course|new|show|without|not|diet|pick)=[^&]/.test(location.search))
        document.getElementById('page').dataset.mode = 'results';
    </script>
    <div class="app" id="app" data-state="loading">
      <header class="top">
        <h1><a href="/" id="home-link"><Wordmark /></a></h1>
        <p class="from" id="from">{fromLine}</p>
      </header>

      <form class="search" id="search-form" role="search" action="/" method="get" aria-label="Recipes">
        <label class="visually-hidden" for="q">Search recipes by dish, ingredient, cuisine or creator</label>
        <div class="box" id="box">
          <div class="fields">
          <ul class="tags" id="with-chips" aria-label="Added to your search" data-amp-mask data-creators={creatorNames}></ul>
          <script is:inline>
            // A link to a search with tags (?with=tofu&cuisine=Thai) shows them from the first
            // paint, as plain labels, so the box is already its full height when the recipes
            // arrive and search.ts draws the real ones (with their × buttons).
            (function () {
              var p = new URLSearchParams(location.search);
              var list = document.getElementById('with-chips');
              var names = {};
              try {
                names = JSON.parse(list.dataset.creators || '{}');
              } catch (e) {}
              var ids = function (k) {
                return (p.get(k) || '').split(',').filter(Boolean);
              };
              var add = function (kind, label) {
                var li = document.createElement('li');
                var tag = document.createElement('span');
                tag.className = 'tag tag-' + kind;
                tag.textContent = label;
                var x = document.createElement('span');
                x.className = 'x';
                x.setAttribute('aria-hidden', 'true');
                x.textContent = '×';
                tag.appendChild(x);
                li.appendChild(tag);
                list.appendChild(li);
              };
              var plain = function (id) {
                return id.replace(/[-_]/g, ' ');
              };
              ids('site').forEach(function (id) {
                if (names[id]) add('creator', 'from ' + names[id]);
              });
              if (p.get('cuisine')) add('cuisine', p.get('cuisine') + ' cuisine');
              if (p.get('new') === '1') add('diet', 'new this week');
              if (p.get('diet') === 'vegetarian' || p.get('diet') === 'vegan') add('diet', p.get('diet'));
              ids('with').forEach(function (id) {
                add('ing', plain(id));
              });
              ids('without').forEach(function (id) {
                add('not', 'no ' + plain(id));
              });
              ids('not').forEach(function (w) {
                add('not', 'no ' + w);
              });
            })();
          </script>
          <input
            id="q"
            name="q"
            type="text"
            autocomplete="off"
            autocapitalize="none"
            spellcheck="false"
            enterkeyhint="search"
            placeholder="A dish, ingredient, cuisine or creator"
            role="combobox"
            aria-autocomplete="list"
            aria-expanded="false"
            aria-controls="q-list"
            aria-describedby="q-hint"
          />
          <script is:inline>
            // The words a link searches for are in the box from the first paint too.
            document.getElementById('q').value = (new URLSearchParams(location.search).get('q') || '').trim();
          </script>
          </div>
          <button class="go" type="submit">
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2.4"></circle><path d="m15.5 15.5 5 5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></path></svg>
            <span class="visually-hidden">Find recipes</span>
          </button>
          <div class="panel" id="q-panel" hidden data-amp-mask>
            <div class="list" id="q-list" role="listbox" aria-label="Suggestions"></div>
          </div>
        </div>
        <p id="q-hint" class="visually-hidden">Suggestions appear as you type. Pick an ingredient, cuisine or creator to add it to your search. Backspace in an empty box removes the last one.</p>
        <p class="visually-hidden" id="announce" role="status" aria-live="polite"></p>
        <p class="home-actions"><button class="lucky" type="button" id="lucky">Pick one at random</button></p>
      </form>

      <div class="filters" role="group" aria-label="Narrow it down">
        <button class="filter" type="button" popovertarget="f-show" id="f-show-btn">Show: <span id="f-show-value">recipes and videos</span></button>
        <button class="filter" type="button" popovertarget="f-course" id="f-course-btn">Course: <span id="f-course-value">any</span></button>
        <button class="filter" type="button" popovertarget="f-cuisine" id="f-cuisine-btn">Cuisine: <span id="f-cuisine-value">any</span></button>
        <button class="filter" type="button" popovertarget="f-site" id="f-site-btn">Creator: <span id="f-site-value">any</span></button>
        <button class="filter" type="button" popovertarget="f-time" id="f-time-btn">Time: <span id="f-time-value">any</span></button>
        <button class="lucky" type="button" id="lucky-results">Pick one at random</button>
        <button class="clear-all" type="button" id="clear-all" hidden>Start over</button>
      </div>

      {FILTERS.map(([id, label]) => (
        <div class="pop" id={`f-${id}`} popover role="dialog" aria-label={label}>
          <fieldset><legend>{label}</legend><div class="options" id={`f-${id}-options`}></div></fieldset>
          <p class="pop-done"><button type="button" popovertarget={`f-${id}`} popovertargetaction="hide">Done</button></p>
        </div>
      ))}

      <p class="status" id="status" role="status" aria-live="polite" tabindex="-1" data-amp-mask>Loading the recipes…</p>

      <p class="note" id="note" hidden></p>

      <section class="picked" id="picked" aria-labelledby="picked-title" hidden tabindex="-1">
        <h2 id="picked-title">Picked at random</h2>
        <div id="picked-card"></div>
        <button class="lucky" type="button" id="lucky-again">Pick another</button>
      </section>

      <h2 class="visually-hidden" id="results-title">Recipes</h2>
      <ol class="results" id="results" aria-labelledby="results-title"></ol>
      <button class="more" type="button" id="more" hidden>Show more</button>

      <section class="videos" id="videos" aria-labelledby="videos-title" hidden>
        <h2 id="videos-title">On YouTube</h2>
        <ol class="results" id="video-results"></ol>
        <button class="more" type="button" id="more-videos" hidden>Show more</button>
      </section>

      <section class="empty" id="empty" aria-label="Nothing found" hidden>
        <p id="fixes"></p>
      </section>

      <!-- The home page's ideas. They also sit under "nothing found", after what to try instead. -->
      <section class="start" id="start" aria-label="Ideas">
        <p id="try"></p>
        <p id="popular"></p>
        <p id="creators"></p>
      </section>

      <p class="also" id="also" hidden></p>

      <noscript>
        <p class="status">
          Search runs in your browser, so it needs JavaScript. You can still search
          <a href="https://thewoksoflife.com/?s=">The Woks of Life</a>,
          <a href="https://hot-thai-kitchen.com/?s=">Hot Thai Kitchen</a> and
          <a href="https://smittenkitchen.com/?s=">Smitten Kitchen</a> directly, see
          <a href="/creators/">every creator here</a>, or <a href="/browse/">browse by cuisine, course and ingredient</a>.
        </p>
      </noscript>
    </div>
  </div>

  <script>
    import '../scripts/search.ts';
  </script>
</LabLayout>

<style>
  .page {
    width: min(100% - 2 * var(--gutter), 68rem);
    margin-inline: auto;
    padding-block: var(--space-4) var(--space-12);
  }

  h2 {
    margin: 0 0 var(--space-3);
    font-size: var(--step-1);
    line-height: 1.25;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .app [hidden] {
    display: none !important;
  }

  /* ---------------------------------------------------------------------------------
     Two modes. Home: the name and the box, centered in the window, a search engine's
     front page. Results: the box moves up, left-aligned, and results fill the page. */
  .top h1 {
    margin: 0;
    font-size: var(--step-1);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .top h1 a {
    color: var(--ink);
    text-decoration: none;
  }

  .from {
    max-width: 36rem;
    margin: var(--space-1) 0 0;
    color: var(--ink-muted);
  }

  .search {
    max-width: 44rem;
    margin-top: var(--space-6);
  }

  /* Home fills the window exactly, like a search engine's front page: the name, the box
     and the ideas sit a little above the middle, the footer sits on the bottom edge, and
     nothing scrolls. The page, main and the column all stretch to the window's height,
     and two flexible spacers (more below than above) do the centering, so the group can
     never be pushed off the top. Spacing shrinks with the window's height, and the
     lower-priority lines step out on short windows (see the height queries below). If
     text is zoomed so far that it can't fit, the page scrolls as usual rather than
     cutting anything off. */
  :global(body:has(#page[data-mode='home']) > main) {
    display: flex;
    flex-direction: column;
  }

  [data-mode='home'] {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding-block: var(--space-4);
  }

  [data-mode='home'] .app {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  [data-mode='home'] .app::before,
  [data-mode='home'] .app::after {
    content: '';
    flex: 2 1 0;
  }

  [data-mode='home'] .app::after {
    flex-grow: 3;
  }

  /* The footer: one quiet line along the bottom, clear of the display settings button. */
  :global(body:has(#page[data-mode='home']) > .lab-foot) {
    padding: var(--space-3) calc(var(--gutter) + 4rem) var(--space-4) var(--gutter);
  }

  [data-mode='home'] .top,
  [data-mode='home'] .search,
  [data-mode='home'] .start {
    width: 100%;
    max-width: 44rem;
    margin-inline: auto;
    text-align: center;
  }

  [data-mode='home'] .top h1 {
    font-size: clamp(2.25rem, 1.6rem + 3vw, 3.75rem);
    letter-spacing: -0.03em;
    line-height: 1.05;
    padding-bottom: 0.12em;
  }

  /* Each group (name and line, box, ideas) gets clear space around it, scaled to the
     window's height, and lines break evenly instead of leaving one word alone. */
  [data-mode='home'] .from {
    max-width: 34rem;
    margin: clamp(var(--space-2), 2svh, var(--space-4)) auto 0;
    text-wrap: balance;
  }

  [data-mode='home'] .search {
    margin-top: clamp(var(--space-4), 4.5svh, var(--space-12));
  }

  [data-mode='home'] .home-actions {
    margin-top: clamp(var(--space-2), 2svh, var(--space-4));
  }

  [data-mode='home'] .start {
    margin-top: clamp(var(--space-4), 4.5svh, var(--space-12));
  }

  [data-mode='home'] .start p {
    margin-bottom: clamp(var(--space-1), 1.4svh, var(--space-3));
  }

  /* The ideas are drawn when the recipes arrive. Their lines hold their place from the
     first paint (two lines each on a phone, one on wider screens), so the name and the box
     don't move when they fill in. */
  [data-mode='home'] .start p {
    min-height: 1lh;
  }

  @media (max-width: 40rem) {
    [data-mode='home'] .start p {
      min-height: 2lh;
    }
  }

  /* Results fill the window from the first paint, so the footer doesn't jump when they arrive. */
  [data-mode='results'] .app {
    min-height: 100svh;
  }

  [data-mode='home'] .start #fresh {
    margin-top: clamp(var(--space-3), 3svh, var(--space-6));
  }

  /* Short windows: the lines that matter least step out first, so the name, the box and
     a few ideas always fit. New this week goes first, then the creator line, then the
     line under the name; a phone on its side keeps just the name, box and one idea line. */
  @media (max-height: 760px) and (max-width: 40rem), (max-height: 640px) {
    [data-mode='home'] .start #fresh {
      display: none;
    }
  }

  @media (max-height: 620px) and (max-width: 40rem), (max-height: 540px) {
    [data-mode='home'] .start #creators {
      display: none;
    }
  }

  @media (max-height: 460px) {
    [data-mode='home'] .from,
    [data-mode='home'] .start #popular {
      display: none;
    }

    [data-mode='home'] .top h1 {
      font-size: 2rem;
    }
  }

  /* While the recipes load: the home page keeps "Loading…" for screen readers only (it
     would nudge the box otherwise), and a search's page doesn't show the ideas' empty lines. */
  [data-mode='home'] .app[data-state='loading'] .status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  [data-mode='results'] .app[data-state='loading'] .start {
    display: none;
  }

  [data-mode='home'] .filters,
  [data-mode='home'] .note,
  [data-mode='home'] .status:empty,
  [data-mode='results'] .home-actions,
  [data-mode='results'] .from {
    display: none;
  }

  /* ---------------------------------------------------------------------------------
     The box. Square-shouldered, a firm rule, tags marked like a highlighter on a
     shopping list. */
  .box {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 3.5rem;
    padding: var(--space-2) 0.35rem var(--space-2) var(--space-4);
    border: 1px solid var(--field-rule);
    border-radius: 0.5rem;
    background: var(--bg-raised);
    text-align: left;
    cursor: text;
  }

  .box:focus-within {
    border-color: var(--accent-ink);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent-ink) 30%, transparent);
  }

  /* Tags and the field wrap together; the button sits beside them as its own item, so at
     any text size it never lies over what's typed. */
  .fields {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .tags {
    display: contents;
    list-style: none;
  }

  .tags :global(li) {
    min-width: 0;
    max-width: 100%;
  }

  .tags :global(.tag) {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    min-height: 2.25rem;
    padding: 0 0.55em;
    overflow-wrap: anywhere;
    margin: 0;
    border: 0;
    border-radius: 0.3rem;
    background: var(--scallion-fill);
    color: var(--ink);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  /* A creator reads as "from Maangchi": the "from" quiet, the name plain. */
  .tags :global(.tag-creator) {
    background: transparent;
    box-shadow: inset 0 0 0 2px var(--creator-ring);
  }

  /* A cuisine ("Thai cuisine"): a basil outline, between an ingredient's fill and a creator's ring. */
  .tags :global(.tag-cuisine) {
    background: transparent;
    box-shadow: inset 0 0 0 2px var(--scallion-fill);
  }

  /* Leaving something out ("no pork"): a plain outline, the word "no" says what it means. */
  .tags :global(.tag-not) {
    background: transparent;
    box-shadow: inset 0 0 0 2px var(--field-rule);
  }

  .tags :global(.x) {
    font-weight: 400;
    font-size: 1.15em;
    line-height: 1;
    color: var(--ink-muted);
  }

  .tags :global(.tag:hover .x),
  .tags :global(.tag:focus-visible .x) {
    color: var(--chili);
  }

  .box input {
    flex: 1 1 12rem;
    width: 100%;
    min-width: min(8rem, 100%);
    min-height: 2.5rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: var(--step-1);
  }

  .box input::placeholder {
    color: var(--ink-muted);
    opacity: 1;
  }

  .box input:focus {
    outline: none;
  }

  .go {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 0.35rem;
    background: var(--go);
    color: var(--go-ink);
    cursor: pointer;
  }

  /* Very large text on a small screen: the button takes its own row under the field, full
     width, so tags and typing get the whole box. Measured against the box, in text sizes. */
  .search {
    container-type: inline-size;
  }

  @container (max-width: 16rem) {
    .box {
      flex-wrap: wrap;
      padding-right: var(--space-4);
    }

    .fields {
      flex-basis: 100%;
    }

    .go {
      width: 100%;
    }
  }

  .go:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 2px;
  }

  /* Suggestions: a plain list under the box. */
  .panel {
    position: absolute;
    z-index: 5;
    top: calc(100% + 0.4rem);
    left: -1px;
    right: -1px;
    padding: var(--space-2);
    background: var(--bg-raised);
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.16);
    line-height: 1.35;
    text-align: left;
    cursor: default;
  }

  .list {
    display: block;
  }

  .panel :global([role='option']) {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    min-height: 2.75rem;
    padding: var(--space-2) var(--space-3);
    border-radius: 0.35rem;
    cursor: pointer;
  }

  /* The chosen suggestion: the basil fill is too faint to see on its own (1.2:1), so a
     tomato bar down its left edge marks it (well over 3:1 in light and dark). */
  .panel :global([role='option'][aria-selected='true']) {
    background: var(--scallion-fill);
    box-shadow: inset 4px 0 0 var(--accent-ink);
  }

  /* A line between things you add (creators, ingredients), recipes you open, and the
     plain search for the words. */
  .panel :global([role='group'] + [role='group']),
  .panel :global([role='group'] + [role='option']) {
    margin-top: var(--space-1);
    padding-top: var(--space-1);
    border-top: 1px solid var(--line);
  }

  .panel :global(.opt-thumb) {
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.35rem;
    object-fit: cover;
    background: var(--line);
  }

  .panel :global(.opt-text) {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .panel :global(.opt-meta) {
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .panel :global([aria-selected='true'] .opt-meta) {
    color: var(--ink);
  }

  .panel :global(mark) {
    background: var(--scallion-fill);
    color: inherit;
    border-radius: 0.1em;
  }

  .panel :global(.opt-name) {
    font-weight: 700;
  }

  .home-actions {
    margin: var(--space-4) 0 0;
  }

  .lucky,
  .clear-all,
  .more,
  .status :global(button),
  .empty :global(button),
  .start :global(button) {
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    font: inherit;
    text-decoration: underline;
